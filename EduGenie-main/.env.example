# EduGenie Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (Required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key

# Optional: Gemini Model Name (Default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Allowed CORS origins (comma-separated list for backend routing)
# CORS_ORIGINS=http://localhost:5500,http://localhost:8080

# Optional: Rate limiting setup (Default: 30 requests per 60 seconds)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=60

# Optional: Logging verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
